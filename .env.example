# --- Lokal (tanpa docker) ---
# DATABASE_URL=postgres://pemos:isi-password@localhost:5432/pemos

# --- Docker compose (VPS) ---
# Isi file .env di folder ini dengan password postgres:
# POSTGRES_PASSWORD=ganti-dengan-password-kuat
# Aplikasi membaca DATABASE_URL dari docker-compose.yml:
# postgres://pemos:<POSTGRES_PASSWORD>@pemos-postgres:5432/pemos
